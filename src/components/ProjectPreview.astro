---
interface Props {
	readonly index: number;
	readonly title: string;
	readonly summary: string;
	readonly role: ReadonlyArray<string>;
	readonly technologies: ReadonlyArray<string>;
	readonly status: string;
	readonly coverImage: string;
	readonly coverAlt: string;
	readonly liveUrl?: string;
	readonly sourceUrl?: string;
	readonly slug: string;
}

const {
	index,
	title,
	summary,
	role,
	technologies,
	status,
	coverImage,
	coverAlt,
	liveUrl,
	sourceUrl,
	slug
} = Astro.props;
const number = String(index).padStart(2, '0');
const isEven = index % 2 === 0;
---

<article class:list={['project-preview', { reverse: isEven }]}>
	<div class="project-copy">
		<div class="project-heading">
			<span class="project-number" aria-hidden="true">{number}</span>
			<div>
				<p class="eyebrow">Selected work / {status}</p>
				<h3>{title}</h3>
			</div>
		</div>

		<p class="summary">{summary}</p>

		<dl>
			<div>
				<dt>Role</dt>
				<dd>{role.join(' · ')}</dd>
			</div>
			<div>
				<dt>System</dt>
				<dd>{technologies.join(' · ')}</dd>
			</div>
		</dl>

		<div class="project-links">
			<a class="text-link" href={`/work/${slug}`}>View case study</a>
			{
				liveUrl && (
					<a class="text-link muted-link" href={liveUrl} target="_blank" rel="noreferrer">
						Live product
					</a>
				)
			}
			{
				sourceUrl && (
					<a class="text-link muted-link" href={sourceUrl} target="_blank" rel="noreferrer">
						Source
					</a>
				)
			}
		</div>
	</div>

	<a class="project-visual" href={`/work/${slug}`} aria-label={`Read the ${title} case study`}>
		<div class="image-stage">
			<img src={coverImage} alt={coverAlt} loading="lazy" decoding="async" />
		</div>
		<div class="visual-meta meta">
			<span>Project {number}</span>
			<span>Open case study ↗</span>
		</div>
	</a>
</article>

<style>
	.project-preview {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 4.5rem);
		align-items: center;
		border-top: 1px solid var(--line);
		padding-block: clamp(3rem, 7vw, 6.5rem);
	}

	.project-copy {
		grid-column: 1 / span 5;
	}

	.project-visual {
		grid-column: 7 / -1;
		border: 1px solid var(--line-strong);
		background: var(--surface);
		text-decoration: none;
	}

	.reverse .project-copy {
		grid-column: 8 / -1;
		grid-row: 1;
	}

	.reverse .project-visual {
		grid-column: 1 / span 6;
		grid-row: 1;
	}

	.project-heading {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1rem;
		align-items: start;
	}

	.project-number {
		font-family: var(--font-mono);
		font-size: clamp(2.2rem, 5vw, 4.8rem);
		font-weight: 300;
		line-height: 0.9;
		letter-spacing: -0.08em;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
	}

	h3 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 5rem);
		font-weight: 520;
		letter-spacing: -0.055em;
		line-height: 0.95;
	}

	.summary {
		max-width: 35rem;
		margin: clamp(2rem, 5vw, 4.5rem) 0 2.25rem 5rem;
		color: var(--muted);
		font-size: clamp(1.05rem, 1.5vw, 1.25rem);
		line-height: 1.55;
	}

	dl {
		margin: 0 0 2rem 5rem;
		border-top: 1px solid var(--line);
	}

	dl div {
		display: grid;
		grid-template-columns: 5rem 1fr;
		gap: 1rem;
		border-bottom: 1px solid var(--line);
		padding-block: 0.75rem;
	}

	dt,
	dd {
		margin: 0;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	dd {
		color: var(--muted);
		font-size: 0.86rem;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-left: 5rem;
		font-size: 0.85rem;
	}

	.muted-link {
		color: var(--muted);
	}

	.image-stage {
		display: grid;
		min-height: 30rem;
		place-items: center;
		overflow: hidden;
		background:
			linear-gradient(var(--line) 1px, transparent 1px),
			linear-gradient(90deg, var(--line) 1px, transparent 1px), var(--surface);
		background-size: 4rem 4rem;
	}

	.image-stage img {
		width: 100%;
		height: 100%;
		max-height: 38rem;
		object-fit: contain;
		transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.project-visual:hover img {
		transform: scale(1.018);
	}

	.visual-meta {
		display: flex;
		justify-content: space-between;
		border-top: 1px solid var(--line);
		padding: 0.65rem 0.8rem;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.project-preview,
		.project-preview.reverse {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 2.5rem;
		}

		.project-copy,
		.reverse .project-copy,
		.project-visual,
		.reverse .project-visual {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.project-heading {
			grid-template-columns: 3rem 1fr;
		}

		.summary,
		dl,
		.project-links {
			margin-left: 4rem;
		}

		.image-stage {
			min-height: 20rem;
		}
	}

	@media (max-width: 560px) {
		.project-heading {
			grid-template-columns: 1fr;
		}

		.project-number {
			font-size: 2.6rem;
		}

		.summary,
		dl,
		.project-links {
			margin-left: 0;
		}

		dl div {
			grid-template-columns: 4rem 1fr;
		}

		.image-stage {
			min-height: 16rem;
		}
	}
</style>
