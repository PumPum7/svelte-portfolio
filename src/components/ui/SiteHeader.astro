---
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="page-grid header-grid">
		<a class="wordmark" href="/" aria-label="Pum — home">pum.works</a>

		<nav aria-label="Primary navigation">
			<a href={path === '/' ? '#work' : '/#work'}>Work</a>
			<a href={path === '/' ? '#about' : '/#about'}>About</a>
			<a href="https://github.com/PumPum7" target="_blank" rel="noreferrer">GitHub</a>
			<a href={path === '/' ? '#contact' : '/#contact'}>Contact</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-height);
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--canvas) 91%, transparent);
		backdrop-filter: blur(14px);
	}

	.header-grid {
		height: 100%;
		align-items: center;
	}

	.wordmark {
		grid-column: 1 / span 3;
		width: fit-content;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		text-decoration: none;
	}

	nav {
		display: flex;
		grid-column: 8 / -1;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
	}

	nav a:hover {
		color: var(--accent);
	}

	@media (max-width: 800px) {
		.wordmark {
			grid-column: 1 / span 1;
		}

		nav {
			grid-column: 2 / -1;
			gap: 0.85rem;
			justify-content: flex-end;
		}

		nav a:nth-child(2),
		nav a:nth-child(3) {
			display: none;
		}
	}
</style>
