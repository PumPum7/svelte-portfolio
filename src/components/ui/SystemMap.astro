<style>
	.system-map {
		margin: 0;
	}

	figcaption {
		margin-bottom: 0.75rem;
		color: var(--muted);
	}

	.map-frame {
		border: 1px solid var(--line-strong);
		background: color-mix(in srgb, var(--canvas) 82%, transparent);
	}

	svg {
		width: 100%;
		color: var(--line-strong);
	}

	.nodes rect {
		fill: var(--canvas);
		stroke: var(--line-strong);
	}

	.nodes .accent-node {
