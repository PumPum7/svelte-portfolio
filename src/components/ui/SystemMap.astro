		font-size: 11px;
		font-weight: 600;
		fill: var(--ink);
	}

	.labels text:nth-of-type(5),
	.labels text:nth-of-type(6) {
		fill: white;
	}

	.pulse {
		fill: var(--accent);
		transform-origin: 390px 195px;
		animation: pulse 2.8s ease-out infinite;
	}

	.axis {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		border-top: 1px solid var(--line);
		padding: 0.6rem 0.75rem;
		color: var(--muted);
	}

	.axis span:last-child {
		text-align: right;
	}

	.trace-hint {
		color: var(--accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.request-trace {
			transition: none;
		}
	}

	@keyframes pulse {
		0%,
