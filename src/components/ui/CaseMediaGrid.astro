---
interface Props {
	readonly variant: 'screens' | 'sprites';
	readonly label: string;
}

const { variant, label } = Astro.props;
---

<div class:list={['case-media-grid', variant]} aria-label={label}>
	<slot />
</div>

<style>
	.case-media-grid {
		display: grid;
		width: min(78vw, 70rem);
		margin: 5rem 0 6rem;
	}

	.case-media-grid :global(figure) {
		margin: 0;
	}

	.case-media-grid :global(img) {
		width: 100%;
		border: 1px solid var(--line-strong);
	}

	.case-media-grid :global(figcaption) {
		font-family: var(--font-mono);
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.screens {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.screens :global(figcaption) {
		border-bottom: 1px solid var(--line);
		padding-block: 0.7rem;
		color: var(--muted);
		font-size: 0.62rem;
	}

	.sprites {
		grid-template-columns: repeat(6, minmax(0, 1fr));
		margin-block: 4rem 6rem;
		border: 1px solid var(--line-strong);
		background: var(--surface);
	}

	.sprites :global(figure) {
		display: grid;
		place-items: center;
		border-right: 1px solid var(--line);
		padding: 1.2rem 0.6rem 0.7rem;
	}

	.sprites :global(figure:last-child) {
		border-right: 0;
	}

	.sprites :global(img) {
		max-width: 7rem;
		border: 0;
		image-rendering: pixelated;
	}

	.sprites :global(figcaption) {
		margin-top: 0.45rem;
		color: var(--accent);
		font-size: 0.58rem;
	}

	@media (max-width: 800px) {
		.case-media-grid {
			width: 100%;
			margin-block: 3.5rem;
		}

		.sprites {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.sprites :global(figure) {
			border-bottom: 1px solid var(--line);
		}
	}

	@media (max-width: 560px) {
		.screens {
			grid-template-columns: 1fr;
		}

		.sprites {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
