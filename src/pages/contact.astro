---
import ContactForm from '../components/ContactForm.svelte';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact — Michael"
	description="Send Michael a message about a technical question or one of the projects shown on pum.works."
>
	<main id="main-content" class="contact-page page-grid">
		<header>
			<p class="eyebrow">Contact / pum.works</p>
			<h1>Send a message.</h1>
			<p>
				For questions, technical discussions, or anything related to the work shown here, use the
				form. GitHub is the best fallback.
			</p>
			<a class="text-link" href="https://github.com/PumPum7" target="_blank" rel="noreferrer"
				>GitHub / PumPum7</a
			>
		</header>
		<section aria-label="Contact form">
			<ContactForm client:visible />
		</section>
	</main>
</BaseLayout>

<style>
	.contact-page {
		min-height: calc(100svh - var(--header-height));
		align-items: start;
		padding-block: clamp(4rem, 9vw, 8rem);
	}

	header {
		position: sticky;
		top: calc(var(--header-height) + 3rem);
		grid-column: 1 / span 5;
	}

	h1 {
		max-width: 8ch;
		margin: 1rem 0 2rem;
		font-size: clamp(4rem, 9vw, 8rem);
		font-weight: 520;
		letter-spacing: -0.075em;
		line-height: 0.86;
	}

	header > p:not(.eyebrow) {
		max-width: 30rem;
		margin-bottom: 2rem;
		color: var(--muted);
		font-size: 1.1rem;
	}

	section {
		grid-column: 7 / -1;
		border-top: 1px solid var(--line);
		padding-top: 1.5rem;
	}

	@media (max-width: 800px) {
		header,
		section {
			grid-column: 1 / -1;
		}

		header {
			position: static;
			margin-bottom: 4rem;
		}
	}
</style>
